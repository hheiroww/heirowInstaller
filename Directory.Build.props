<Project>
  <PropertyGroup>
    <Version>2026.11.13.1</Version>
    <ProjectZPackageVersion Condition="'$(ProjectZPackageVersion)' == ''">[2026.11.4.1]</ProjectZPackageVersion>
    <InstallerGraphicsBackend Condition="'$(InstallerGraphicsBackend)' == ''">DirectX12</InstallerGraphicsBackend>
    <ProjectZRoot Condition="'$(UseLocalProjectZ)' == 'true' and '$(ProjectZRoot)' == ''">$(USERPROFILE)\Documents\GitHub\Project-Z</ProjectZRoot>
    <InstallerDesktopPlatform Condition="'$(InstallerDesktopPlatform)' == '' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-'))">Linux</InstallerDesktopPlatform>
    <InstallerDesktopPlatform Condition="'$(InstallerDesktopPlatform)' == '' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-'))">macOS</InstallerDesktopPlatform>
    <InstallerDesktopPlatform Condition="'$(InstallerDesktopPlatform)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">Linux</InstallerDesktopPlatform>
    <InstallerDesktopPlatform Condition="'$(InstallerDesktopPlatform)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">macOS</InstallerDesktopPlatform>
    <InstallerDesktopPlatform Condition="'$(InstallerDesktopPlatform)' == ''">Windows</InstallerDesktopPlatform>
    <InstallerDesktopFramework Condition="'$(InstallerDesktopPlatform)' == 'Windows'">net10.0-windows7.0</InstallerDesktopFramework>
    <InstallerDesktopFramework Condition="'$(InstallerDesktopPlatform)' != 'Windows'">net10.0</InstallerDesktopFramework>
    <InstallerProjectZPackage Condition="'$(InstallerDesktopPlatform)' == 'Windows'">ProjectZ</InstallerProjectZPackage>
    <InstallerProjectZPackage Condition="'$(InstallerDesktopPlatform)' != 'Windows'">ProjectZ.$(InstallerDesktopPlatform)</InstallerProjectZPackage>
    <InstallerProjectZProject Condition="'$(InstallerDesktopPlatform)' == 'Windows'">$(ProjectZRoot)/Project Z Windows.vbproj</InstallerProjectZProject>
    <InstallerProjectZProject Condition="'$(InstallerDesktopPlatform)' != 'Windows'">$(ProjectZRoot)/Project Z $(InstallerDesktopPlatform)/ProjectZ.$(InstallerDesktopPlatform).vbproj</InstallerProjectZProject>
    <Authors>heirow</Authors>
    <Company>SocketJack</Company>
    <Product>heirowInstaller</Product>
    <Copyright>Copyright (c) 2026 heirow</Copyright>
    <RepositoryUrl>https://github.com/hheiroww/heirowInstaller</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>
</Project>
