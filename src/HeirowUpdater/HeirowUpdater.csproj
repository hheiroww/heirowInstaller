<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Condition="'$(InstallerDesktopPlatform)' == 'Windows'">
    <ApplicationManifest>../Shared/DesktopApplication.manifest</ApplicationManifest>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFramework>$(InstallerDesktopFramework)</TargetFramework><OutputType>WinExe</OutputType><AssemblyName>heirowUpdater</AssemblyName>
    <UseWindowsForms Condition="'$(InstallerDesktopPlatform)' == 'Windows'">true</UseWindowsForms><UseWPF Condition="'$(InstallerDesktopPlatform)' == 'Windows'">true</UseWPF><PlatformTarget>AnyCPU</PlatformTarget>
    <ApplicationIcon>../../assets/heirowInstaller.ico</ApplicationIcon>
    <Description>SocketJack-powered application update companion for heirowInstaller.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/DesktopPlatform.cs" Link="DesktopPlatform.cs" /><ProjectReference Include="../HeirowUpdater.SocketJack/HeirowUpdater.SocketJack.csproj" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../HeirowInstaller.Publishing/HeirowInstaller.Publishing.csproj" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="$(InstallerProjectZPackage)" Version="$(ProjectZPackageVersion)" Condition="'$(UseLocalProjectZ)' != 'true'" />
    <ProjectReference Include="$(InstallerProjectZProject)" Condition="'$(UseLocalProjectZ)' == 'true'" />
    <EmbeddedResource Include="../../assets/heirowInstaller-256.png" LogicalName="HeirowUpdater.Assets.Logo.png" />
    <Content Include="../../assets/heirowInstaller.png" Link="Assets/heirowInstaller.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../assets/heirowInstaller.ico" Link="Assets/heirowInstaller.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
