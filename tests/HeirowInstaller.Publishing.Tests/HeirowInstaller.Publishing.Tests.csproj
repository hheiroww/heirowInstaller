<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/HeirowInstaller.Publishing/HeirowInstaller.Publishing.csproj" />
    <ProjectReference Include="../../src/HeirowInstaller.Core/HeirowInstaller.Core.csproj" />
    <ProjectReference Include="../../src/HeirowInstaller.Cli/HeirowInstaller.Cli.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="RecordCliFixturePath" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildThisFileDirectory)../../src/HeirowInstaller.Cli/HeirowInstaller.Cli.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)" BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="CliFixtureTarget" />
    </MSBuild>
    <WriteLinesToFile File="$(TargetDir)cli-fixture-path.txt" Lines="@(CliFixtureTarget)" Overwrite="true" />
  </Target>
</Project>
