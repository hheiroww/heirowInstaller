<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0-windows7.0</TargetFramework></PropertyGroup>
  <ItemGroup>
    <Compile Remove="Fixtures/**/*.cs" />
    <Compile Include="../../src/HeirowInstaller.App/InstalledApplicationLaunch.cs" Link="Production/InstalledApplicationLaunch.cs" />
    <ProjectReference Include="../../src/HeirowUpdater.SocketJack/HeirowUpdater.SocketJack.csproj" />
    <ProjectReference Include="../../src/HeirowUpdater/HeirowUpdater.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="Fixtures/WorkingDirectoryProbe/WorkingDirectoryProbe.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyOwnedLaunchFixtures" AfterTargets="Build">
    <MSBuild Projects="../../src/HeirowUpdater/HeirowUpdater.csproj;Fixtures/WorkingDirectoryProbe/WorkingDirectoryProbe.csproj" Targets="GetTargetPath" BuildInParallel="false" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="OwnedFixtureTarget" />
    </MSBuild>
    <ItemGroup><OwnedFixtureFile Include="%(OwnedFixtureTarget.RootDir)%(OwnedFixtureTarget.Directory)**/*" /></ItemGroup>
    <Copy SourceFiles="@(OwnedFixtureFile)" DestinationFiles="@(OwnedFixtureFile->'$(OutDir)LaunchFixtures/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
